<Window x:Class="TradeApp.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TradeApp.Client.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Вход в систему" Height="620" Width="520" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Window.DataContext><vm:LoginViewModel/></Window.DataContext>
    <Grid>
        <materialDesign:Card Margin="44" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                MinWidth="400" MinHeight="420" UniformCornerRadius="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                          Padding="48,40,48,44" MaxHeight="520">
                <StackPanel>
                    <TextBlock Text="Торговое приложение" FontSize="15" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Авторизация" FontSize="26" FontWeight="SemiBold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,32"/>
                    <TextBlock Text="Логин" FontSize="14" Foreground="#4B5563" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,18"/>
                    <TextBlock Text="Пароль" FontSize="14" Foreground="#4B5563" Margin="0,0,0,8"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,20" Background="White" Padding="1" CornerRadius="6">
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" 
                                    Style="{StaticResource PasswordBoxStyle}" BorderThickness="0" Background="Transparent" Padding="12,11"/>
                    </Border>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,18" 
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" FontSize="13"/>
                    <Button Content="Войти" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" 
                            HorizontalAlignment="Stretch" Margin="0,0,0,14" Padding="28,16" FontSize="16" MinHeight="48"/>
                    <Border Height="1" Background="#E5E7EB" Margin="0,18,0,18"/>
                    <TextBlock Text="Без учётной записи — только просмотр товаров" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button Content="Войти как гость (без пароля)" Command="{Binding GuestLoginCommand}" 
                            HorizontalAlignment="Stretch" Padding="28,16" FontSize="15" MinHeight="48"
                            Background="#EFF6FF" Foreground="#1D4ED8" BorderThickness="1" BorderBrush="#93C5FD" Cursor="Hand"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</Window>
